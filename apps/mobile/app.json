{
  "expo": {
    "name": "AVARAN",
    "slug": "avaran-mobile",
    "scheme": "avaran",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F2EF",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avaran.security"
    },
    "android": {
      "package": "com.avaran.security",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F2EF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F2EF"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://s44-production.up.railway.app",
      "eas": {
        "projectId": "08a48009-eb7d-429b-994d-14abf398faa9"
      }
    }
  }
}

# S40 — environment variable template.
#
# Copy this file to `.env` and adjust values for your local machine.
# `.env` itself is git-ignored (see .gitignore) — never commit real secrets.
#
# Only the backend-scaffold variables below are currently read by the
# application (apps/api/app/core/config.py). The remaining sections are
# placeholders for later phases (docs/DEVELOPMENT_PLAN.md) so the file
# communicates the eventual shape of configuration without inventing
# functionality that doesn't exist yet.

# --------------------------------------------------------------------------
# Backend (apps/api) — active in this scaffold
# --------------------------------------------------------------------------
APP_NAME="S40 API"
ENVIRONMENT=development

# Bootstrap local database. Defaults to a SQLite file (Avaran.db) at the
# repository root if unset — see docs/DEVELOPMENT_PLAN.md for the planned
# PostgreSQL migration.
DATABASE_URL=sqlite:///./Avaran.db

# Prototype-only pepper used to hash sensitive identifiers (phone numbers,
# device/recipient handles — see apps/api/app/core/security.py). The
# checked-in default is an obviously insecure placeholder; override it
# here for anything beyond local dev. Hashing/key-management scheme is
# still intentionally undecided — see docs/SECURITY.md.
HASH_PEPPER=s40-dev-only-pepper-change-me

# --------------------------------------------------------------------------
# Database (future — PostgreSQL, per spec §3/§18) — not yet used
# --------------------------------------------------------------------------
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# REDIS_URL=

# --------------------------------------------------------------------------
# Frontend (apps/web) — active for the /demo route
# --------------------------------------------------------------------------
# apps/web reads its own .env.local (git-ignored), not this file directly —
# these are documented here so the shape is visible in one place.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Explicit, opt-in only. When unset/false, a real API failure surfaces as a
# real error state — /demo never falls back to scripted mock data silently.
NEXT_PUBLIC_DEMO_ALLOW_MOCK_FALLBACK=false

# --------------------------------------------------------------------------
# ML / Voice (ml/, voice/) — not yet scaffolded
# --------------------------------------------------------------------------
# ML_MODEL_DIR=
# VOICE_STT_MODEL=

# ==========================================================================
# S40 — .gitignore
# See CLAUDE.md / docs/SECURITY.md for the rationale behind secret handling.
# ==========================================================================

node_modules/
.next/
out/
build/
dist/
.expo/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# --------------------------------------------------------------------------
# Android / Gradle build caches & Generated Native Projects
# --------------------------------------------------------------------------
.gradle/
# android/ used to be blanket-ignored as "fully regenerable via `expo
# prebuild`". That stopped being true once this app got real custom native
# code (live-call/UPI-watcher/fraud-overlay Kotlin services, the
# CallGuardModule native bridge, manifest permissions/service
# declarations) that prebuild does NOT generate and WILL silently delete
# if a teammate re-runs prebuild without it being tracked. Git can't
# selectively re-include files under a directory that's itself excluded
# (see `git help gitignore`, "It is not possible to re-include a file..."),
# so rather than fight that with a huge negation list, the directory is
# tracked and only the genuinely disposable/machine-specific build output
# below is excluded.
**/android/.gradle/
**/android/app/build/
**/android/build/
**/android/.cxx/
**/android/*.iml
**/android/local.properties
**/android/app/debug.keystore

# --------------------------------------------------------------------------
# Releases (standalone APK distribution)
# --------------------------------------------------------------------------
!releases/
!releases/*.apk

# --------------------------------------------------------------------------
# Python (apps/api, ml/, voice/, scripts/)
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.coverage
htmlcov/

# --------------------------------------------------------------------------
# Environment / secrets
# --------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.old
.env.*.bak
*.pem
*.key
*.crt
*.p12
*credentials*.json
*secret*
!*.example
!.env.example

# --------------------------------------------------------------------------
# IDE / OS
# --------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# --------------------------------------------------------------------------
# ML — generated artifacts, not source
# --------------------------------------------------------------------------
# Downloaded external datasets. NEVER commit these — several carry licences
# that restrict redistribution, and the repository must not become a
# distribution channel for them (see docs/DATA_STRATEGY.md).
ml/data/raw/
ml/data/processed/
ml/data/synthetic/
ml/data/Original/
# Large columnar/archive formats that only ever appear as dataset dumps.
*.parquet
*.feather
*.zip.part

# Allow pre-trained lightweight model artifacts for instant out-of-the-box demo execution
!ml/models/fraud_xgb.json
!ml/models/calibrated_fraud.joblib
!ml/models/anomaly_forest.joblib
!ml/models/voice_nlp.joblib
!ml/models/scaler.joblib
!ml/models/eval_results.json

# Experiment/evaluation outputs.
ml/experiments/
ml/reports/

# Python source under ml/models/ (artifact.py, model_registry.py) IS source
# and stays tracked — the rules above deliberately target artifact trees
# only, never `ml/models/` wholesale.
#
# Tiny hand-authored adapter fixtures ARE source and must stay tracked. They
# are not excerpts of any public dataset (see ml/tests/fixtures/README.md).
!ml/tests/fixtures/
!ml/tests/fixtures/**

# --------------------------------------------------------------------------
# Logs / generated reports
# --------------------------------------------------------------------------
*.log
logs/
*.report.json
coverage/

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Decision (documented in the version-control foundation report): no
# Avaran.db file exists in this repository yet. When the SQLite dev/test
# scaffold is introduced, the default is to treat it as generated/local-only
# data and NOT track it — reproducibility should come from a seed script
# (scripts/seed_database.py, per docs/DEVELOPMENT_PLAN.md Phase 3), not from
# committing a binary database file. Reassess if a specific small, hand
# curated Avaran.db is later designated as a tracked fixture.
Avaran.db
*.sqlite3
*.sqlite3-journal
*.db-journal
# Ad-hoc backups and superseded copies made during local verification/repair
# sessions — never source, never the canonical file itself.
Avaran.db.backup*
Avaran.db.before-*
*.STALE*

# --------------------------------------------------------------------------
# Per-user pattern-engine artifacts (apps/api/app/services/user_pattern_trainer.py)
# --------------------------------------------------------------------------
# Generated on demand from each user's own transaction history — same
# "reproducible from a script, not committed" reasoning as Avaran.db above.
/storage/

# --------------------------------------------------------------------------
# Docker / infra local overrides
# --------------------------------------------------------------------------
docker-compose.override.yml
